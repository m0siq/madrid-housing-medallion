# MadridHousingScanner – Environment Variables
# =============================================
# Copy this file to .env and fill in your values.
# The .env file is ignored by .gitignore — never commit it.

# ── Data lake paths ────────────────────────────────────────────────────────────
DATA_DIR=data
BRONZE_DIR=data/bronze
SILVER_DIR=data/silver
GOLD_DIR=data/gold

# ── DuckDB ────────────────────────────────────────────────────────────────────
DUCKDB_PATH=data/madrid_housing.duckdb

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
TOP_DEALS_LIMIT=10

# ── Scraper ───────────────────────────────────────────────────────────────────
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT_MS=30000
SCRAPER_MAX_RETRIES=3
SCRAPER_DELAY_MIN_S=2.0
SCRAPER_DELAY_MAX_S=5.0

# ── Stealth / Anti-detection ─────────────────────────────────────────────────
# Enable fingerprint masking, human behavior simulation, and CDP patches
STEALTH_ENABLED=true

# Visit a neutral page (Google) before target URL to warm up the session
WARMUP_ENABLED=true

# Residential proxy URL (optional). Rotate IPs to bypass rate limiting.
# Format: http://username:password@proxy-host:port
# Providers: Bright Data, Oxylabs, SmartProxy, etc.
# PROXY_URL=http://user:pass@proxy.example.com:8080

# ── Spark ─────────────────────────────────────────────────────────────────────
SPARK_APP_NAME=MadridHousingScanner
SPARK_MASTER=local[*]

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_FORMAT options: "json" (production) | "console" (development)
LOG_LEVEL=INFO
LOG_FORMAT=console
